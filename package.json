{
  "name": "motion",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "restart:local": "powershell -ExecutionPolicy Bypass -File scripts/restart-local.ps1 -StartLtx -StartComfy -StartVite",
    "desktop": "electron .",
    "desktop:build": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "undici": "^8.10.2",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "latest",
    "electron-builder": "latest"
  },
  "build": {
    "appId": "local.motion.studio",
    "productName": "Motion Studio",
    "directories": {
      "output": "release"
    },
    "asar": false,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "scripts/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "artifactName": "Motion-Studio-${version}.exe"
    }
  }
}
